# This deployment's build variables (docs/design/deploy.md#build-variables),
# read by scripts/deploy-image.sh and e2e/deploy.spec.js; one set in the
# environment wins. Unset ones keep a build's defaults (src/config.js).
# The dev central until the owner switches to https://network.satorinet.io:
VITE_CENTRAL_URL=https://central2.satorinet.io
# Satori's public relay, over TLS (central lists only ws://, which an https page can't open):
VITE_NOSTR_RELAYS=wss://nostr.satorinet.io
# The Base RPC, pinned in the build (publicnode after it), so the Satori Network's rpcUrl never picks it:
VITE_BASE_RPC=https://sepolia.base.org
